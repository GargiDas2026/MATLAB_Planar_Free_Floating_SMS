function tau = MPC_Controller_Casadi(x0,param)

import casadi.*

persistent solver U_prev

Np = param.Np;
dt = param.dt;

tau_max = param.tau_max(:);

LB = repmat(-tau_max,Np,1);
UB = repmat( tau_max,Np,1);

%% ---------- Optimizer ----------

if isempty(solver)

    solver = BuildSolver(param);

end

%% Optimization variables

U = MX.sym('U',3,Np);
f = SMS_Model_Casadi();
%% ---------- Save optimum ----------

U_prev = U;

%% ---------- Apply first control ----------

tau = U(1:3);

end